<Window x:Class="RepoPacker.UI.MarketplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RepoPacker.UI"
        Title="RepoPacker Community Marketplace"
        Height="620" Width="720"
        MinHeight="500" MinWidth="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header & Repo Selector -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Community Marketplace" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="Explore, preview, and download community presets and themes via GitHub Discussions." 
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
            </StackPanel>

            <TextBox Grid.Column="1" Width="180" Height="30" VerticalContentAlignment="Center"
                     Text="{Binding RepositorySlug, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,8,0" ToolTip="GitHub repository in owner/repo format" />

            <Button Grid.Column="2" Content="Fetch" Width="75" Height="30"
                    Style="{StaticResource GitHubSecondaryButton}"
                    Command="{Binding RefreshMarketplaceCommand}" />
        </Grid>

        <!-- Search and Filter Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Height="32" Padding="8,0" VerticalContentAlignment="Center"
                     Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Filter items by title or author name..." />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                <ComboBox Width="110" Height="32" SelectedValuePath="Content"
                          SelectedValue="{Binding SelectedTypeFilter, Mode=TwoWay}">
                    <ComboBoxItem Content="All" IsSelected="True" />
                    <ComboBoxItem Content="Presets" />
                    <ComboBoxItem Content="Themes" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Items Display -->
        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="1" CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding DisplayedItems}" Margin="12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:MarketplaceItem}">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Type Badge -->
                                    <Border Grid.Column="0" Background="{DynamicResource BtnSecondaryBgBrush}" 
                                            CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold" Foreground="#58A6FF" />
                                    </Border>

                                    <!-- Metadata -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding AuthorDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Upvotes -->
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12">
                                        <Run Text="▲ " Foreground="#3FB950"/>
                                        <Run Text="{Binding UpvoteCount, Mode=OneWay}"/>
                                    </TextBlock>

                                    <!-- Actions -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="View" 
                                                Style="{StaticResource GitHubSecondaryButton}"
                                                Height="28" MinWidth="54" Padding="6,0" Margin="0,0,6,0"
                                                Command="{Binding DataContext.OpenDiscussionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />

                                        <!-- Installed vs Install State -->
                                        <Button Content="Installed" 
                                                IsEnabled="False"
                                                Style="{StaticResource GitHubSecondaryButton}"
                                                Height="28" MinWidth="70" Padding="8,0"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}" />

                                        <Button Content="Install" 
                                                Height="28" MinWidth="70" Padding="8,0"
                                                Command="{Binding DataContext.InstallItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource GitHubPrimaryButton}" TargetType="Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Status Footer -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
            <ProgressBar Height="2" IsIndeterminate="True" 
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" 
                         Foreground="#2EA043" VerticalAlignment="Bottom" />
        </Grid>
    </Grid>
</Window>