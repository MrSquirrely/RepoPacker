<Window x:Class="RepoPacker.UI.MarketplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:RepoPacker.UI"
        Title="Community Marketplace"
        Height="650" Width="760"
        MinHeight="500" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Segmented Tab Bar Container Style -->
        <Style x:Key="SegmentedTabListBox" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Tab Item Button Style -->
        <Style x:Key="SegmentedTabItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="tabBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource BtnSecondaryHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Titlebar -->
        <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand / Icon -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Path Data="M2.5 3A1.5 1.5 0 001 4.5V5h14v-.5A1.5 1.5 0 0013.5 3h-11zM1 6.5V13a1.5 1.5 0 001.5 1.5h11A1.5 1.5 0 0015 13V6.5H1zm4.5 2a.75.75 0 01.75.75v2.5a.75.75 0 01-1.5 0v-2.5a.75.75 0 01.75-.75zm5 0a.75.75 0 01.75.75v2.5a.75.75 0 01-1.5 0v-2.5a.75.75 0 01.75-.75z" 
                          Fill="{DynamicResource TextPrimaryBrush}" 
                          Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="Community Marketplace" FontWeight="SemiBold" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Window Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource TitleBarButton}" Click="OnMinimizeClick" ToolTip="Minimize">
                        <Path Data="M0 0 H10" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" SnapsToDevicePixels="True"/>
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" Click="OnMaximizeRestoreClick" ToolTip="Maximize / Restore">
                        <Path x:Name="MaximizeIcon" Data="M0.5 0.5 H9.5 V9.5 H0.5 Z" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" SnapsToDevicePixels="True"/>
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButton}" Click="OnCloseClick" ToolTip="Close">
                        <Path Data="M0 0 L10 10 M10 0 L0 10" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" SnapsToDevicePixels="True"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Window Content -->
        <Grid Grid.Row="1" Margin="24,18,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header & Direct Refresh -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="RepoPacker Ecosystem" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Community-submitted presets and themes curated via GitHub Discussions." 
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                </StackPanel>

                <Button Grid.Column="1" 
                        Content="Refresh" 
                        Width="90" Height="32"
                        Style="{StaticResource GitHubSecondaryButton}"
                        Command="{Binding RefreshMarketplaceCommand}" />
            </Grid>

            <!-- Search and Segmented Tab Bar -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Height="34" Padding="10,0" VerticalContentAlignment="Center"
                         Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Filter items by title or author name..." />

                <!-- Segmented Tab Selection Bar -->
                <ListBox Grid.Column="1" 
                         Margin="12,0,0,0"
                         ItemsSource="{Binding FilterTypes}"
                         SelectedItem="{Binding SelectedTypeFilter, Mode=TwoWay}"
                         Style="{StaticResource SegmentedTabListBox}"
                         ItemContainerStyle="{StaticResource SegmentedTabItem}" />
            </Grid>

            <!-- Items Feed Container -->
            <Border Grid.Row="2" Background="{DynamicResource CardBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding DisplayedItems}" Margin="14">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:MarketplaceItem}">
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Type Badge -->
                                        <Border Grid.Column="0" Background="{DynamicResource BtnSecondaryBgBrush}" 
                                                CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold" Foreground="#58A6FF" />
                                        </Border>

                                        <!-- Metadata -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{Binding AuthorDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Upvotes Count -->
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12">
                                            <Run Text="▲ " Foreground="#3FB950"/>
                                            <Run Text="{Binding UpvoteCount, Mode=OneWay}"/>
                                        </TextBlock>

                                        <!-- Action Buttons -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="View" 
                                                    Style="{StaticResource GitHubSecondaryButton}"
                                                    Height="28" MinWidth="54" Padding="6,0" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.OpenDiscussionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />

                                            <!-- Install Button -->
                                            <Button Content="Install" 
                                                    Height="28" MinWidth="70" Padding="8,0"
                                                    Command="{Binding DataContext.InstallItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style BasedOn="{StaticResource GitHubPrimaryButton}" TargetType="Button">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Uninstall Button -->
                                            <Button Content="Uninstall" 
                                                    Height="28" MinWidth="70" Padding="8,0"
                                                    Command="{Binding DataContext.UninstallItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style BasedOn="{StaticResource GitHubDangerButton}" TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanUninstall}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Default Protected Indicator -->
                                            <Button Content="Default" 
                                                    IsEnabled="False"
                                                    Height="28" MinWidth="70" Padding="8,0">
                                                <Button.Style>
                                                    <Style BasedOn="{StaticResource GitHubSecondaryButton}" TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsInstalled}" Value="True" />
                                                                    <Condition Binding="{Binding IsDefaultItem}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Status Footer -->
            <Grid Grid.Row="3" Margin="0,10,0,0">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                <ProgressBar Height="2" IsIndeterminate="True" 
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" 
                             Foreground="#2EA043" VerticalAlignment="Bottom" />
            </Grid>
        </Grid>
    </Grid>
</Window>